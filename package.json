{
  "name": "getcompetitive",
  "version": "8.0.2",
  "description": "MCP server for Pokémon Champions competitive play: official Regulation Sets, usage-derived meta, and battle math for team building and decision making",
  "type": "module",
  "bin": {
    "getcompetitive": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-app.mjs && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "node test/smoke.mjs",
    "test": "npm run build && node test/smoke.mjs && node test/champions.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pokemon",
    "mcp",
    "model-context-protocol",
    "vgc",
    "competitive",
    "team-building",
    "pokemon-champions",
    "showdown"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mriver15/getcompetitive.git"
  },
  "homepage": "https://github.com/mriver15/getcompetitive",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pkmn/dex": "^0.10.11",
    "@smogon/calc": "^0.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "esbuild": "0.25.0",
    "typescript": "^7.0.2"
  }
}
